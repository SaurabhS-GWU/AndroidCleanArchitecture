<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/countryListFragment">

    <fragment
        android:id="@+id/countryListFragment"
        android:name="com.example.cleanarchitectureapp.presentation.ui.fragments.CountryListFragment"
        android:label="Country List">
        <action
            android:id="@+id/action_countryListFragment_to_countryDetailFragment"
            app:destination="@id/countryDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/countryDetailFragment"
        android:name="com.example.cleanarchitectureapp.presentation.ui.fragments.CountryDetailFragment"
        android:label="Country Details">
        <argument
            android:name="country"
            app:argType="com.example.cleanarchitectureapp.domain.model.Country" />
    </fragment>

</navigation> 